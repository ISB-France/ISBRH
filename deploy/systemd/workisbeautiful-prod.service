[Unit]
Description=WorkIsBeautiful Production
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/var/www/app-prod
ExecStart=/usr/bin/docker compose -f deploy/docker-compose.prod.yml --env-file /etc/workisbeautiful/prod.env -p workisbeautiful-prod up -d
ExecStop=/usr/bin/docker compose -f deploy/docker-compose.prod.yml -p workisbeautiful-prod down
StandardOutput=journal

[Install]
WantedBy=multi-user.target
