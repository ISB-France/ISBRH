[Unit]
Description=ISBRH Recette
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/var/www/app-recette
ExecStart=/usr/bin/docker compose -f deploy/docker-compose.recette.yml --env-file /etc/isbrh/recette.env -p isbrh-recette up -d
ExecStop=/usr/bin/docker compose -f deploy/docker-compose.recette.yml -p isbrh-recette down
StandardOutput=journal

[Install]
WantedBy=multi-user.target
